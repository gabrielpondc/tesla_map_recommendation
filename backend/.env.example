# 启动时选择地图：amap 或 baidu（也可 MAP_PROVIDER=baidu ./start.sh）
MAP_PROVIDER=amap

# 百度地图 JavaScript API AK
BAIDU_AK=

# 百度地图 Web 服务 AK（Python 后端检索沿途充电站）
BAIDU_WEB_AK=

# 高德 Web 服务 Key（Python 后端使用；需创建“Web服务”类型 Key）
AMAP_WEB_KEY=

# 高德 JavaScript API 2.0 Key
AMAP_JS_KEY=

# 高德 JavaScript API 2.0 安全密钥
AMAP_SECURITY_CODE=

# OpenAI 兼容接口（仅在常规算法无法用已确认站点覆盖全程时启用）
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-5.4
AI_TIMEOUT_SECONDS=18
